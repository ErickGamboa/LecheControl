<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de arranque: el logo centrado sobre blanco. Se queda en blanco
  también en modo oscuro (ver drawable-v21) porque el logo es azul marino y
  verde: sobre un fondo oscuro casi no se lee.

  El PNG tiene fondo transparente, así que no aparece ningún recuadro
  alrededor del logo.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
