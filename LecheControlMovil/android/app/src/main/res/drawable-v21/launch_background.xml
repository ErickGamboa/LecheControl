<?xml version="1.0" encoding="utf-8"?>
<!--
  Igual que la versión base: blanco fijo, no `?android:colorBackground`. Con
  el color del sistema, en modo oscuro el logo -azul marino sobre fondo
  negro- quedaba ilegible durante el arranque.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
